{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --esm src/app.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "start": "node --import tsx src/app.ts",
    "type-check": "tsc --noEmit",
    "vitest": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/lib-storage": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@fastify/cors": "^10.0.0",
    "@hyzyla/pdfium": "^2.1.12",
    "@obravision/db": "workspace:*",
    "@obravision/types": "workspace:*",
    "bullmq": "^5.71.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
