# ============================================
# ProjetaPro Production Environment
# Copy to /home/projetapro/app/.env
# ============================================

# Database (from setup-vps.sh output)
DATABASE_URL="postgresql://projetapro:YOUR_DB_PASSWORD@localhost:5432/projetapro"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth.js
NEXTAUTH_SECRET="GENERATE_WITH: openssl rand -base64 32"
NEXTAUTH_URL="https://YOUR_DOMAIN"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (resend.com - transactional email)
RESEND_API_KEY="re_your_api_key"

# App URLs
NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN"
NEXT_PUBLIC_API_URL="https://api.YOUR_DOMAIN"
API_URL="https://api.YOUR_DOMAIN"
WEB_URL="https://YOUR_DOMAIN"

# Cloudflare R2 (dash.cloudflare.com)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="projetapro"
R2_PUBLIC_URL="https://pub-XXXX.r2.dev"

# API Port
PORT=4000
