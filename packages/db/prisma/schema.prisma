// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENGENHEIRO
  CLIENTE
}

enum ObraTipo {
  RESIDENCIAL
  COMERCIAL
  REFORMA
}

// ---- Auth.js required models (do not rename) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Application models ----

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role                 @default(ENGENHEIRO)
  empresaId      String?
  empresa        Empresa?             @relation(fields: [empresaId], references: [id])
  onboardingStep Int                  @default(0) // 0=not started, 1=empresa done, 2=obra done, 3=complete
  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model Empresa {
  id        String       @id @default(cuid())
  tenantId  String       @unique @default(cuid()) // used for RLS set_config
  nome      String
  cnpj      String?
  logoUrl   String? // R2 key — null in Phase 1, prepared for Phase 2
  members     User[]
  obras       Obra[]
  statuses    ObraStatus[]
  invites     Invitation[]
  leads       Lead[]
  fornecedores Fornecedor[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Obra {
  id          String      @id @default(cuid())
  tenantId    String // = empresa.tenantId — RLS uses this
  nome        String
  logradouro  String
  numero      String
  cidade      String
  estado      String      @db.Char(2)
  cep         String
  tipo        ObraTipo
  area        Decimal     @db.Decimal(10, 2) // m²
  lat         Float?      // geocoded latitude — for weather alerts (Phase 3)
  lon         Float?      // geocoded longitude — for weather alerts (Phase 3)
  archived    Boolean     @default(false)
  coverUrl    String? // R2 key — null in Phase 1
  statusId    String?
  status      ObraStatus? @relation(fields: [statusId], references: [id])
  empresaId   String
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  members     ObraMember[]
  invitations Invitation[]
  plantas       Planta[]
  etapas        Etapa[]
  rdoEntradas   RdoEntrada[]
  orcamento     Orcamento?
  requisicoes   CompraRequisicao[]
  pedidos       CompraPedido[]
  depositos     Deposito[]
  medicoesFisicas MedicaoFisica[]
  medicoesContrato MedicaoContrato[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([empresaId])
  @@index([tenantId])
}

model ObraStatus {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  color     String @default("#1A6B5A")
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  obras     Obra[]

  @@index([empresaId])
}

model ObraMember {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  obraId      String
  role        Role
  permissions Json? // Cliente permissions (Phase 1: stored, enforced in Phase 2)
  obra        Obra     @relation(fields: [obraId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, obraId])
}

model Invitation {
  id        String    @id @default(cuid())
  tenantId  String
  token     String    @unique
  email     String? // null = shareable link
  role      Role
  obraId    String?
  obra      Obra?     @relation(fields: [obraId], references: [id])
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  invitedBy String // User.id
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing")
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())
}

// ---- Phase 2: PDF viewer + anchored comments ----

enum DisciplinaTipo {
  ARQUITETURA
  ESTRUTURAL
  ELETRICA
  HIDRAULICA
  INCENDIO
  TOPOGRAFIA
  CUSTOMIZADO
}

model Planta {
  id               String          @id @default(cuid())
  tenantId         String
  obraId           String
  obra             Obra            @relation(fields: [obraId], references: [id])
  nome             String
  disciplina       DisciplinaTipo
  disciplinaCustom String?         // populated when disciplina = CUSTOMIZADO
  revisoes         PlantaRevisao[]
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model PlantaRevisao {
  id          String   @id @default(cuid())
  tenantId    String
  plantaId    String
  planta      Planta   @relation(fields: [plantaId], references: [id])
  revisao     String   // "R0", "R1", "R2", etc.
  changelog   String   // required — what changed
  r2Key       String   // original PDF key in R2
  tilesReady  Boolean  @default(false)
  tilesPrefix String?  // R2 prefix for WebP tiles, e.g. "tiles/plantaRevisaoId/"
  pageCount   Int?
  pins        Pin[]
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  uploadedBy  String   // User.id

  @@index([plantaId])
  @@index([tenantId])
}

model Pin {
  id              String        @id @default(cuid())
  tenantId        String
  plantaRevisaoId String
  plantaRevisao   PlantaRevisao @relation(fields: [plantaRevisaoId], references: [id])
  authorId        String
  x               Float         // normalized 0.0–1.0 (left–right)
  y               Float         // normalized 0.0–1.0 (top–bottom)
  pageNumber      Int
  thread          Thread?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([plantaRevisaoId])
  @@index([tenantId])
}

model Thread {
  id        String          @id @default(cuid())
  tenantId  String
  pinId     String          @unique
  pin       Pin             @relation(fields: [pinId], references: [id])
  messages  ThreadMessage[]
  deletedAt DateTime?
  createdAt DateTime        @default(now())
}

model ThreadMessage {
  id        String   @id @default(cuid())
  tenantId  String
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id])
  authorId  String
  content   String   @db.Text
  mentions  String[] // array of User.id mentioned with @
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([threadId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   // recipient
  type      String   // "new_pin" | "new_reply" | "new_revision" | "mention"
  payload   Json     // { pinId?, threadId?, obraId, authorName, ... }
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

// ---- Phase 3: Cronograma + RDO ----

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
}

model Etapa {
  id            String   @id @default(cuid())
  tenantId      String
  obraId        String
  obra          Obra     @relation(fields: [obraId], references: [id])
  nome          String   // "Fundacao", "Alvenaria", etc.
  ordem         Int      // display order in Gantt
  climaSensivel Boolean  @default(false) // default for child tasks
  tarefas       Tarefa[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model Tarefa {
  id            String       @id @default(cuid())
  tenantId      String
  obraId        String
  etapaId       String
  etapa         Etapa        @relation(fields: [etapaId], references: [id])
  nome          String
  responsavelId String?      // User.id
  status        TarefaStatus @default(PENDENTE)
  startDate     DateTime
  endDate       DateTime
  climaSensivel Boolean?     // null = inherit from Etapa; true/false = override
  progressoReal Int          @default(0) // 0-100, updated from RDO entries
  rdoEntradas   RdoEntrada[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([obraId])
  @@index([etapaId])
  @@index([tenantId])
}

// ---- Phase 3: RDO (Relatorio Diario de Obra) ----

model RdoEntrada {
  id              String    @id @default(cuid())
  tenantId        String
  obraId          String
  obra            Obra      @relation(fields: [obraId], references: [id])
  tarefaId        String?
  tarefa          Tarefa?   @relation(fields: [tarefaId], references: [id])
  autorId         String    // User.id
  data            DateTime  @db.Date
  texto           String?   @db.Text
  maoDeObra       Json?
  materiais       Json?
  ocorrencias     String?   @db.Text
  climaCondicao   String?
  climaTemp       Float?
  climaUmidade    Float?
  climaFonteDado  String?   // "open-meteo" | "manual"
  fotos           RdoFoto[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([obraId, data])
  @@index([obraId])
  @@index([tarefaId])
  @@index([tenantId])
}

model RdoFoto {
  id           String     @id @default(cuid())
  tenantId     String
  rdoEntradaId String
  rdoEntrada   RdoEntrada @relation(fields: [rdoEntradaId], references: [id])
  r2Key        String
  legenda      String?
  ordem        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([rdoEntradaId])
  @@index([tenantId])
}

// ---- Phase 4: Orcamento + Compras + Medicoes ----

enum RequisicaoStatus {
  RASCUNHO
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
}

enum PedidoStatus {
  RASCUNHO
  ENVIADO
  CONFIRMADO
  ENTREGUE_PARCIAL
  ENTREGUE
  CANCELADO
}

enum MovimentacaoTipo {
  ENTRADA
  SAIDA
  TRANSFERENCIA
}

enum MedicaoStatus {
  RASCUNHO
  SUBMETIDA
  APROVADA
  REJEITADA
}

model SinapiComposicao {
  id            String   @id @default(cuid())
  codigo        String   @unique
  descricao     String
  unidade       String
  custoUnitario Decimal  @db.Decimal(12, 4)
  estado        String   @db.Char(2) // UF da tabela SINAPI
  referencia    String?  // mes/ano de referencia, ex: "2024-11"
  searchVec     Unsupported("tsvector")?

  @@index([codigo])
  @@index([estado])
}

model Orcamento {
  id        String           @id @default(cuid())
  tenantId  String
  obraId    String           @unique
  obra      Obra             @relation(fields: [obraId], references: [id])
  bdi       Decimal          @db.Decimal(5, 2) @default(0)
  pdfR2Key  String?
  etapas    OrcamentoEtapa[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
}

model OrcamentoEtapa {
  id          String          @id @default(cuid())
  tenantId    String
  orcamentoId String
  orcamento   Orcamento       @relation(fields: [orcamentoId], references: [id])
  nome        String
  ordem       Int
  itens       OrcamentoItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orcamentoId])
  @@index([tenantId])
}

model OrcamentoItem {
  id            String         @id @default(cuid())
  tenantId      String
  etapaId       String
  etapa         OrcamentoEtapa @relation(fields: [etapaId], references: [id])
  descricao     String
  unidade       String
  quantidade    Decimal        @db.Decimal(12, 4)
  custoUnitario Decimal        @db.Decimal(12, 4)
  sinapiCodigo  String?
  requisicoes   CompraRequisicao[]
  medicaoItens  MedicaoFisicaItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([etapaId])
  @@index([tenantId])
}

model Fornecedor {
  id         String         @id @default(cuid())
  tenantId   String
  empresaId  String
  empresa    Empresa        @relation(fields: [empresaId], references: [id])
  nome       String
  cnpj       String?
  contato    String?
  email      String?
  telefone   String?
  categorias String[]
  cotacoes   CompraCotacao[]
  pedidos    CompraPedido[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([empresaId])
  @@index([tenantId])
}

model CompraRequisicao {
  id             String           @id @default(cuid())
  tenantId       String
  obraId         String
  obra           Obra             @relation(fields: [obraId], references: [id])
  orcamentoItemId String?
  orcamentoItem  OrcamentoItem?   @relation(fields: [orcamentoItemId], references: [id])
  descricao      String
  unidade        String
  quantidade     Decimal          @db.Decimal(12, 4)
  status         RequisicaoStatus @default(RASCUNHO)
  solicitanteId  String           // User.id
  aprovadorId    String?          // User.id
  aprovadoEm     DateTime?
  cotacoes       CompraCotacao[]
  pedidoItens    CompraPedidoItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model CompraCotacao {
  id            String           @id @default(cuid())
  tenantId      String
  requisicaoId  String
  requisicao    CompraRequisicao @relation(fields: [requisicaoId], references: [id])
  fornecedorId  String
  fornecedor    Fornecedor       @relation(fields: [fornecedorId], references: [id])
  precoUnitario Decimal          @db.Decimal(12, 4)
  prazoEntrega  Int?             // dias
  observacoes   String?
  selecionada   Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([requisicaoId])
  @@index([fornecedorId])
  @@index([tenantId])
}

model CompraPedido {
  id           String             @id @default(cuid())
  tenantId     String
  obraId       String
  obra         Obra               @relation(fields: [obraId], references: [id])
  fornecedorId String
  fornecedor   Fornecedor         @relation(fields: [fornecedorId], references: [id])
  status       PedidoStatus       @default(RASCUNHO)
  totalEstimado Decimal           @db.Decimal(12, 4) @default(0)
  observacoes  String?
  pdfR2Key     String?
  itens        CompraPedidoItem[]
  movimentacoes MovimentacaoEstoque[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([obraId])
  @@index([fornecedorId])
  @@index([tenantId])
}

model CompraPedidoItem {
  id           String           @id @default(cuid())
  tenantId     String
  pedidoId     String
  pedido       CompraPedido     @relation(fields: [pedidoId], references: [id])
  requisicaoId String?
  requisicao   CompraRequisicao? @relation(fields: [requisicaoId], references: [id])
  descricao    String
  unidade      String
  quantidade   Decimal          @db.Decimal(12, 4)
  precoUnitario Decimal         @db.Decimal(12, 4)
  createdAt    DateTime         @default(now())

  @@index([pedidoId])
  @@index([tenantId])
}

model Deposito {
  id            String                @id @default(cuid())
  tenantId      String
  obraId        String
  obra          Obra                  @relation(fields: [obraId], references: [id])
  nome          String
  tipo          String                @default("almoxarifado")
  movimentacoes MovimentacaoEstoque[]
  transferenciasOrigem  MovimentacaoEstoque[] @relation("TransferenciaOrigem")
  transferenciasDestino MovimentacaoEstoque[] @relation("TransferenciaDestino")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model MovimentacaoEstoque {
  id              String           @id @default(cuid())
  tenantId        String
  depositoId      String
  deposito        Deposito         @relation(fields: [depositoId], references: [id])
  pedidoId        String?
  pedido          CompraPedido?    @relation(fields: [pedidoId], references: [id])
  origemId        String?
  origem          Deposito?        @relation("TransferenciaOrigem", fields: [origemId], references: [id])
  destinoId       String?
  destino         Deposito?        @relation("TransferenciaDestino", fields: [destinoId], references: [id])
  tipo            MovimentacaoTipo
  descricao       String
  unidade         String
  quantidade      Decimal          @db.Decimal(12, 4)
  custoUnitario   Decimal?         @db.Decimal(12, 4)
  etapaDestino    String?          // tag de custo por atividade
  registradoPor   String           // User.id
  createdAt       DateTime         @default(now())

  @@index([depositoId])
  @@index([tenantId])
}

model MedicaoFisica {
  id          String              @id @default(cuid())
  tenantId    String
  obraId      String
  obra        Obra                @relation(fields: [obraId], references: [id])
  periodo     String              // ex: "2024-11" (mes/ano)
  status      MedicaoStatus       @default(RASCUNHO)
  aprovadoPor String?             // User.id
  aprovadoEm  DateTime?
  itens       MedicaoFisicaItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model MedicaoFisicaItem {
  id              String        @id @default(cuid())
  tenantId        String
  medicaoId       String
  medicao         MedicaoFisica @relation(fields: [medicaoId], references: [id])
  orcamentoItemId String
  orcamentoItem   OrcamentoItem @relation(fields: [orcamentoItemId], references: [id])
  percentualMedido Decimal      @db.Decimal(5, 2) // 0-100
  acumulado       Decimal       @db.Decimal(5, 2) // total acumulado até este boletim
  createdAt       DateTime      @default(now())

  @@index([medicaoId])
  @@index([tenantId])
}

model MedicaoContrato {
  id           String               @id @default(cuid())
  tenantId     String
  obraId       String
  obra         Obra                 @relation(fields: [obraId], references: [id])
  empreiteiroId String              // User.id ou nome livre
  contrato     String?              // numero ou descricao do contrato
  periodo      String               // ex: "2024-11"
  status       MedicaoStatus        @default(RASCUNHO)
  aprovadoPor  String?              // User.id
  aprovadoEm   DateTime?
  pdfR2Key     String?
  itens        MedicaoContratoItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model MedicaoContratoItem {
  id              String          @id @default(cuid())
  tenantId        String
  medicaoId       String
  medicao         MedicaoContrato @relation(fields: [medicaoId], references: [id])
  descricao       String
  unidade         String
  quantidade      Decimal         @db.Decimal(12, 4)
  valorUnitario   Decimal         @db.Decimal(12, 4)
  acumulado       Decimal         @db.Decimal(12, 4) @default(0)
  createdAt       DateTime        @default(now())

  @@index([medicaoId])
  @@index([tenantId])
}
