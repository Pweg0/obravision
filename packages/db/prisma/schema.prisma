// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENGENHEIRO
  CLIENTE
}

enum ObraTipo {
  RESIDENCIAL
  COMERCIAL
  REFORMA
}

// ---- Auth.js required models (do not rename) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Application models ----

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role                 @default(ENGENHEIRO)
  empresaId      String?
  empresa        Empresa?             @relation(fields: [empresaId], references: [id])
  onboardingStep Int                  @default(0) // 0=not started, 1=empresa done, 2=obra done, 3=complete
  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model Empresa {
  id        String       @id @default(cuid())
  tenantId  String       @unique @default(cuid()) // used for RLS set_config
  nome      String
  cnpj      String?
  logoUrl   String? // R2 key — null in Phase 1, prepared for Phase 2
  members   User[]
  obras     Obra[]
  statuses  ObraStatus[]
  invites   Invitation[]
  leads     Lead[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Obra {
  id          String      @id @default(cuid())
  tenantId    String // = empresa.tenantId — RLS uses this
  nome        String
  logradouro  String
  numero      String
  cidade      String
  estado      String      @db.Char(2)
  cep         String
  tipo        ObraTipo
  area        Decimal     @db.Decimal(10, 2) // m²
  lat         Float?      // geocoded latitude — for weather alerts (Phase 3)
  lon         Float?      // geocoded longitude — for weather alerts (Phase 3)
  archived    Boolean     @default(false)
  coverUrl    String? // R2 key — null in Phase 1
  statusId    String?
  status      ObraStatus? @relation(fields: [statusId], references: [id])
  empresaId   String
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  members     ObraMember[]
  invitations Invitation[]
  plantas     Planta[]
  etapas      Etapa[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([empresaId])
  @@index([tenantId])
}

model ObraStatus {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  color     String @default("#1A6B5A")
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  obras     Obra[]

  @@index([empresaId])
}

model ObraMember {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  obraId      String
  role        Role
  permissions Json? // Cliente permissions (Phase 1: stored, enforced in Phase 2)
  obra        Obra     @relation(fields: [obraId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, obraId])
}

model Invitation {
  id        String    @id @default(cuid())
  tenantId  String
  token     String    @unique
  email     String? // null = shareable link
  role      Role
  obraId    String?
  obra      Obra?     @relation(fields: [obraId], references: [id])
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  invitedBy String // User.id
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing")
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())
}

// ---- Phase 2: PDF viewer + anchored comments ----

enum DisciplinaTipo {
  ARQUITETURA
  ESTRUTURAL
  ELETRICA
  HIDRAULICA
  INCENDIO
  TOPOGRAFIA
  CUSTOMIZADO
}

model Planta {
  id               String          @id @default(cuid())
  tenantId         String
  obraId           String
  obra             Obra            @relation(fields: [obraId], references: [id])
  nome             String
  disciplina       DisciplinaTipo
  disciplinaCustom String?         // populated when disciplina = CUSTOMIZADO
  revisoes         PlantaRevisao[]
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model PlantaRevisao {
  id          String   @id @default(cuid())
  tenantId    String
  plantaId    String
  planta      Planta   @relation(fields: [plantaId], references: [id])
  revisao     String   // "R0", "R1", "R2", etc.
  changelog   String   // required — what changed
  r2Key       String   // original PDF key in R2
  tilesReady  Boolean  @default(false)
  tilesPrefix String?  // R2 prefix for WebP tiles, e.g. "tiles/plantaRevisaoId/"
  pageCount   Int?
  pins        Pin[]
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  uploadedBy  String   // User.id

  @@index([plantaId])
  @@index([tenantId])
}

model Pin {
  id              String        @id @default(cuid())
  tenantId        String
  plantaRevisaoId String
  plantaRevisao   PlantaRevisao @relation(fields: [plantaRevisaoId], references: [id])
  authorId        String
  x               Float         // normalized 0.0–1.0 (left–right)
  y               Float         // normalized 0.0–1.0 (top–bottom)
  pageNumber      Int
  thread          Thread?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([plantaRevisaoId])
  @@index([tenantId])
}

model Thread {
  id        String          @id @default(cuid())
  tenantId  String
  pinId     String          @unique
  pin       Pin             @relation(fields: [pinId], references: [id])
  messages  ThreadMessage[]
  deletedAt DateTime?
  createdAt DateTime        @default(now())
}

model ThreadMessage {
  id        String   @id @default(cuid())
  tenantId  String
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id])
  authorId  String
  content   String   @db.Text
  mentions  String[] // array of User.id mentioned with @
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([threadId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   // recipient
  type      String   // "new_pin" | "new_reply" | "new_revision" | "mention"
  payload   Json     // { pinId?, threadId?, obraId, authorName, ... }
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

// ---- Phase 3: Cronograma + RDO ----

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
}

model Etapa {
  id            String   @id @default(cuid())
  tenantId      String
  obraId        String
  obra          Obra     @relation(fields: [obraId], references: [id])
  nome          String   // "Fundacao", "Alvenaria", etc.
  ordem         Int      // display order in Gantt
  climaSensivel Boolean  @default(false) // default for child tasks
  tarefas       Tarefa[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([obraId])
  @@index([tenantId])
}

model Tarefa {
  id            String       @id @default(cuid())
  tenantId      String
  obraId        String
  etapaId       String
  etapa         Etapa        @relation(fields: [etapaId], references: [id])
  nome          String
  responsavelId String?      // User.id
  status        TarefaStatus @default(PENDENTE)
  startDate     DateTime
  endDate       DateTime
  climaSensivel Boolean?     // null = inherit from Etapa; true/false = override
  progressoReal Int          @default(0) // 0-100, updated from RDO entries
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([obraId])
  @@index([etapaId])
  @@index([tenantId])
}
