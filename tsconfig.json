{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@projetapro/db": ["./packages/db/src/index.ts"],
      "@projetapro/types": ["./packages/types/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
